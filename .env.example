# Namma Seva Agent AI — Environment Configuration Example

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Namma Seva Agent"
VERSION=1.0.0

# Database Connection (Async SQLite for dev/test, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./backend/namma_seva.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/namma_seva

# Security & JWT Tokens (Must be a 64+ char random string in production)
SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt-signing
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider ("mock", "gemini", "openai")
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# WhatsApp Business Cloud API (Meta Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=namma_seva_verify_token_2026

# Document Storage Limits
MAX_UPLOAD_SIZE_BYTES=5242880
