# Namma Seva Agent AI — Environment Configuration Example

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Namma Seva Agent"
VERSION=1.0.0

# Database Connection (Async SQLite for dev/test, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./backend/namma_seva.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/namma_seva

# Security & JWT Tokens (Must be distinct 64+ char random strings in production)
SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt-signing
DOC_ENCRYPTION_KEY=replace-with-a-dedicated-256-bit-aes-key-for-file-encryption
FIELD_ENCRYPTION_KEY=replace-with-a-dedicated-256-bit-aes-key-for-field-pii-encryption
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Operating Modes
DEMO_MODE=false

# AI Provider ("mock", "gemini", "openai")
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# WhatsApp Business Cloud API (Meta Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=namma_seva_verify_token_2026
WHATSAPP_APP_SECRET=replace-with-meta-app-secret-min-16-chars

# Rate Limiting & Proxy Configuration
RATE_LIMIT_ENABLED=true
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Document Storage Limits
MAX_UPLOAD_SIZE_BYTES=5242880
