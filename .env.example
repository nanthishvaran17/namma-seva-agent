# Environment Settings
ENVIRONMENT=development
PROJECT_NAME="Namma Seva Agent"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: SQLite (can use PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/namma_seva)
DATABASE_URL=sqlite+aiosqlite:///backend/namma_seva.db

# LLM Providers (mock, gemini, openai)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=namma_seva_verify_token_2026
