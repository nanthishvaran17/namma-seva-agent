{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GovernmentServicePlaybook",
  "description": "Validated schema for Tamil Nadu Government Service Playbooks in Namma Seva Agent",
  "type": "object",
  "required": [
    "service_id",
    "name_en",
    "name_ta",
    "description_en",
    "description_ta",
    "department",
    "category",
    "portal_url",
    "eligibility_rules",
    "required_documents",
    "fee",
    "processing_time",
    "application_steps",
    "dependencies",
    "official_sources",
    "last_verified",
    "verification_status",
    "version"
  ],
  "properties": {
    "service_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name_en": {
      "type": "string",
      "minLength": 3
    },
    "name_ta": {
      "type": "string",
      "minLength": 3
    },
    "description_en": {
      "type": "string"
    },
    "description_ta": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "certificates_revenue",
        "scholarships_education",
        "welfare_social",
        "farmer_agriculture",
        "employment_assistance",
        "ration_civil_supplies",
        "pensions_senior",
        "disability_services",
        "land_property",
        "municipal_services"
      ]
    },
    "portal_url": {
      "type": "string",
      "format": "uri"
    },
    "application_url": {
      "type": "string"
    },
    "eligibility_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "description_en", "description_ta"],
        "properties": {
          "rule_id": { "type": "string" },
          "description_en": { "type": "string" },
          "description_ta": { "type": "string" },
          "field": { "type": "string" },
          "operator": { "type": "string", "enum": ["eq", "lte", "gte", "in", "boolean"] },
          "value": {}
        }
      }
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_code", "name_en", "name_ta", "mandatory"],
        "properties": {
          "doc_code": { "type": "string" },
          "name_en": { "type": "string" },
          "name_ta": { "type": "string" },
          "description": { "type": "string" },
          "mandatory": { "type": "boolean" },
          "acceptable_formats": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "optional_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc_code": { "type": "string" },
          "name_en": { "type": "string" },
          "name_ta": { "type": "string" }
        }
      }
    },
    "fee": {
      "type": "object",
      "required": ["amount_inr", "is_free", "verified_description"],
      "properties": {
        "amount_inr": { "type": "number" },
        "is_free": { "type": "boolean" },
        "verified_description": { "type": "string" }
      }
    },
    "processing_time": {
      "type": "object",
      "required": ["working_days", "description_en", "description_ta"],
      "properties": {
        "working_days": { "type": "integer" },
        "description_en": { "type": "string" },
        "description_ta": { "type": "string" }
      }
    },
    "application_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_number", "title_en", "title_ta", "instruction_en", "instruction_ta"],
        "properties": {
          "step_number": { "type": "integer" },
          "title_en": { "type": "string" },
          "title_ta": { "type": "string" },
          "instruction_en": { "type": "string" },
          "instruction_ta": { "type": "string" },
          "action_url": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "certificate_type": { "type": "string" },
        "digitally_signed": { "type": "boolean" },
        "validity_period": { "type": "string" }
      }
    },
    "official_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "publisher", "url", "retrieval_date"],
        "properties": {
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "url": { "type": "string" },
          "retrieval_date": { "type": "string" }
        }
      }
    },
    "last_verified": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": ["DRAFT", "NEEDS_VERIFICATION", "VERIFIED", "RETIRED"]
    },
    "version": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    }
  }
}
